# Copia este archivo como .env y ajusta los valores reales.
# La app lee estas variables al arrancar (config.py).

# --- Modo de la app ---
# demo  -> usa datos de ejemplo locales (no requiere BigQuery)
# prod  -> lee/escribe en BigQuery
APP_MODE=demo

# --- BigQuery ---
GCP_PROJECT=papyrus-delivery-data
BQ_DATASET=habicredit
# Tabla oficial de comisiones CO (solo lectura desde la app)
BQ_TABLA_COMISIONES=comisiones_internas_hc_final
# Tabla de seguimiento de confirmaciones (la app escribe SOLO aqui)
BQ_TABLA_CONFIRMACIONES=comisiones_confirmaciones

# --- API ---
# Clave requerida en el header X-API-Key para api/main.py (excepto /health)
API_KEY=

# --- Acceso ---
# Correos con vista de manager, separados por coma
MANAGER_EMAILS=johhanramirez@habi.co
